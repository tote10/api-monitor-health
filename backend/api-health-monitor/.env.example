PROJECT_NAME="API Health Monitor"
VERSION="0.2.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=True
DATABASE_URL="sqlite:///./api_health_monitor.db"
# For PostgreSQL (Docker Compose sets this automatically) use:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/api_health_monitor"
MONITORING_ENABLED=True
SCHEDULER_POLL_SECONDS=5
CHECK_HISTORY_RETENTION_DAYS=30
CHECK_HISTORY_CLEANUP_INTERVAL_SECONDS=3600

# Accounts and sessions
AUTH_ENABLED=True
ALLOW_REGISTRATION=True
SESSION_COOKIE_NAME="ahm_session"
SESSION_TTL_HOURS=168
# Set to True when the dashboard is served over HTTPS
SESSION_COOKIE_SECURE=False

# Protect targets and webhooks from SSRF (private/reserved addresses)
SSRF_PROTECTION_ENABLED=True
# Allow monitoring internal addresses on a trusted network
ALLOW_PRIVATE_TARGETS=False

# Alerts
ALERT_COOLDOWN_MINUTES=15
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM="api-health-monitor@example.com"
# SMTP_USE_TLS=True
