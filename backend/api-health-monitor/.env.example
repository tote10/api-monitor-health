PROJECT_NAME="API Health Monitor"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=True
DATABASE_URL="sqlite:///./api_health_monitor.db"
# For a separate PostgreSQL installation use:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/api_health_monitor"
MONITORING_ENABLED=True
SCHEDULER_POLL_SECONDS=5
CHECK_HISTORY_RETENTION_DAYS=30
CHECK_HISTORY_CLEANUP_INTERVAL_SECONDS=3600
# Set true when serving the dashboard over HTTPS.
AUTH_SECURE_COOKIE=False

# Optional outage and recovery alerts. Leave destinations blank to disable.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# Docker Compose requires an explicit database password.
# POSTGRES_PASSWORD=
# APP_BIND_ADDRESS=127.0.0.1
# APP_PORT=8000

# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# MONITOR_CONFIG_KEY=
# Optional origin for incident links in alerts, e.g. https://monitor.example.com
# PUBLIC_BASE_URL=
# Enable only for the local demo. Other private and reserved addresses stay blocked.
ALLOW_LOOPBACK_TARGETS=false
TLS_EXPIRY_WARNING_DAYS=14
